/* SKYLINE iPhone controls — shown only on touch-first devices. */
#mobileFlightControls,
#mobileMotionSetup,
#mobileRotateHint { display: none; }

body.skyline-mobile {
  overscroll-behavior: none;
  -webkit-touch-callout: none;
  touch-action: none;
}
body.skyline-mobile #fps { display: none !important; }
body.skyline-mobile #title button[data-act="tutorial"] { display: none !important; }
body.skyline-mobile #shaveWrap {
  bottom: calc(env(safe-area-inset-bottom) + 10px);
  width: min(46vw, 430px);
  padding: 7px 9px 8px;
}
body.skyline-mobile #shaveWrap .label { font-size: 8px; }
body.skyline-mobile #shaveWrap .prox { font-size: 16px; min-width: 58px; }
body.skyline-mobile #challengeTrack {
  right: calc(env(safe-area-inset-right) + 86px);
  top: calc(env(safe-area-inset-top) + 58px);
  width: min(300px, 40vw);
  max-height: 42vh;
  overflow: hidden;
}
body.skyline-mobile #hud .bl { bottom: 6px; left: 148px; transform: scale(.76); transform-origin: left bottom; }
body.skyline-mobile #hud .br { bottom: 8px; right: 148px; transform: scale(.78); transform-origin: right bottom; }
body.skyline-mobile #feed { right: 16px; width: 240px; top: 50%; transform: translateY(-50%) scale(.88); transform-origin: right center; }
body.skyline-mobile #hints { display: none !important; }

#mobileFlightControls {
  position: fixed;
  inset: 0;
  z-index: 58;
  pointer-events: none;
  font-family: var(--sans, -apple-system, BlinkMacSystemFont, sans-serif);
}
body.skyline-mobile #mobileFlightControls { display: block; }
#mobileFlightControls.live { pointer-events: none; }

.mobile-action {
  pointer-events: auto;
  touch-action: none;
  -webkit-tap-highlight-color: transparent;
}
.mobile-action {
  appearance: none;
  border: 1px solid rgba(255,255,255,.2);
  background: rgba(7,11,16,.72);
  color: #eef5fb;
  backdrop-filter: blur(8px);
  box-shadow: 0 5px 20px rgba(0,0,0,.28);
  font: 700 10px/1 var(--sans, sans-serif);
  letter-spacing: .14em;
  text-transform: uppercase;
}
.mobile-action:active,
.mobile-action.held { background: rgba(255,122,61,.28); border-color: rgba(255,122,61,.82); }

#mobileParachute,
#mobilePause {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 10px);
  min-width: 70px;
  height: 40px;
  border-radius: 8px;
}
#mobileParachute { left: calc(env(safe-area-inset-left) + 10px); }
#mobilePause { right: calc(env(safe-area-inset-right) + 10px); }

#mobilePitchGhost {
  position: absolute;
  width: 92px;
  height: 92px;
  margin: -46px 0 0 -46px;
  border-radius: 50%;
  border: 1px solid rgba(111,211,255,.30);
  background: radial-gradient(circle, rgba(111,211,255,.08), rgba(7,11,16,.10) 58%, transparent 60%);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,.12);
  pointer-events: none;
  opacity: 0;
  transition: opacity .08s ease;
}
#mobilePitchGhost::before {
  content: 'DIVE  ↑';
  position: absolute;
  left: 50%;
  bottom: calc(100% + 8px);
  transform: translateX(-50%);
  white-space: nowrap;
  color: rgba(255,255,255,.55);
  font: 700 7px/1 var(--sans, sans-serif);
  letter-spacing: .16em;
}
#mobilePitchGhost::after {
  content: '↓  PULL UP';
  position: absolute;
  left: 50%;
  top: calc(100% + 8px);
  transform: translateX(-50%);
  white-space: nowrap;
  color: rgba(255,255,255,.55);
  font: 700 7px/1 var(--sans, sans-serif);
  letter-spacing: .16em;
}
#mobilePitchGhostKnob {
  position: absolute;
  left: 50%; top: 50%;
  width: 48px; height: 48px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,.38);
  background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.22), rgba(16,23,31,.90));
  box-shadow: 0 5px 18px rgba(0,0,0,.36);
  transform: translate(-50%, -50%);
  will-change: transform;
}
#mobileGestureHint {
  position: absolute;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 7px);
  transform: translateX(-50%);
  color: rgba(255,255,255,.40);
  font: 700 7px/1 var(--sans, sans-serif);
  letter-spacing: .12em;
  white-space: nowrap;
  text-shadow: 0 1px 8px #000;
  pointer-events: none;
}

#mobileRightActions {
  position: absolute;
  right: calc(env(safe-area-inset-right) + 16px);
  bottom: calc(env(safe-area-inset-bottom) + 22px);
  display: flex;
  flex-direction: column;
  pointer-events: none;
}
#mobileRightActions .mobile-action {
  width: 118px;
  height: 66px;
  border-radius: 12px;
  font-size: 11px;
}
#mobileTuck { border-color: rgba(111,211,255,.34); }

#mobileTiltReadout {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 14px);
  left: 50%; transform: translateX(-50%);
  min-width: 152px;
  text-align: center;
  color: rgba(255,255,255,.58);
  font: 700 8px/1 var(--sans, sans-serif);
  letter-spacing: .18em;
  text-transform: uppercase;
  text-shadow: 0 1px 10px #000;
  pointer-events: none;
}
#mobileTiltReadout b { color: #6fd3ff; font-family: var(--mono, monospace); font-size: 10px; }

#mobileMotionSetup {
  position: fixed;
  inset: 0;
  z-index: 230;
  place-items: center;
  padding: 24px;
  background: radial-gradient(90% 70% at 50% 40%, rgba(20,31,44,.97), rgba(4,7,11,.99));
  color: #eef5fb;
}
body.skyline-mobile #mobileMotionSetup.open { display: grid; }
#mobileMotionSetup .motion-card {
  width: min(480px, 88vw);
  padding: 26px 26px 22px;
  border: 1px solid rgba(255,255,255,.13);
  background: rgba(8,12,18,.88);
  box-shadow: 0 18px 70px rgba(0,0,0,.45);
  text-align: center;
}
#mobileMotionSetup h2 { margin: 0 0 10px; font-weight: 300; letter-spacing: .2em; font-size: 23px; }
#mobileMotionSetup p { color: #9bacbd; line-height: 1.6; font-size: 12px; }
#mobileMotionSetup .motion-diagram { margin: 18px auto; font: 700 11px/1.8 var(--mono, monospace); color: #6fd3ff; }
#mobileMotionSetup button {
  width: 100%; min-height: 50px; margin-top: 8px;
  border: 1px solid rgba(255,122,61,.75);
  background: rgba(255,122,61,.14);
  color: #fff;
  font: 700 11px/1 var(--sans, sans-serif);
  letter-spacing: .18em;
  text-transform: uppercase;
}
#mobileMotionStatus { min-height: 18px; color: #ffb07e !important; }

#mobileRotateHint {
  position: fixed;
  inset: 0;
  z-index: 240;
  background: #05080c;
  color: #eef5fb;
  place-items: center;
  text-align: center;
  padding: 28px;
  font: 600 13px/1.6 var(--sans, sans-serif);
  letter-spacing: .12em;
}
body.skyline-mobile.mobile-portrait #mobileRotateHint { display: grid; }
#mobileRotateHint b { display: block; margin-bottom: 12px; color: #6fd3ff; font-size: 20px; letter-spacing: .2em; }

/* Menu touch targets and safe-area spacing. */
body.skyline-mobile .overlay { padding: calc(env(safe-area-inset-top) + 10px) calc(env(safe-area-inset-right) + 10px) calc(env(safe-area-inset-bottom) + 10px) calc(env(safe-area-inset-left) + 10px); }
body.skyline-mobile .overlay-x { top: calc(env(safe-area-inset-top) + 8px); right: calc(env(safe-area-inset-right) + 8px); width: 42px; height: 42px; }
body.skyline-mobile .btn,
body.skyline-mobile .pill,
body.skyline-mobile button { min-height: 38px; }

@media (orientation: portrait) and (pointer: coarse) {
  body.skyline-mobile #mobileFlightControls { visibility: hidden; }
}

/* Right-half hold = desktop-style tight carve. Subtle feedback only. */
body.skyline-mobile.mobile-tight-turn #mobileFlightControls::after {
  content: 'TIGHT CARVE';
  position: absolute;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 24px);
  transform: translateX(-50%);
  color: rgba(255,176,126,.9);
  font: 700 8px/1 var(--sans, sans-serif);
  letter-spacing: .2em;
  text-shadow: 0 1px 10px #000;
  pointer-events: none;
}


body.skyline-mobile.mobile-roll-left #mobileFlightControls::before,
body.skyline-mobile.mobile-roll-right #mobileFlightControls::before {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%,-50%);
  color: rgba(255,176,126,.94);
  font: 800 11px/1 var(--sans, sans-serif);
  letter-spacing: .22em;
  text-shadow: 0 2px 12px #000;
  pointer-events: none;
}
body.skyline-mobile.mobile-roll-left #mobileFlightControls::before { content: '← BARREL ROLL'; }
body.skyline-mobile.mobile-roll-right #mobileFlightControls::before { content: 'BARREL ROLL →'; }

/* v3.1 — iPhone interaction hardening.
   Keep the game feeling like an app: no text/image selection, no callouts,
   no tap highlight, and no browser zoom gestures during play. */
body.skyline-mobile,
body.skyline-mobile * {
  -webkit-user-select: none !important;
  user-select: none !important;
  -webkit-touch-callout: none !important;
  -webkit-tap-highlight-color: transparent !important;
}

body.skyline-mobile img,
body.skyline-mobile svg,
body.skyline-mobile canvas {
  -webkit-user-drag: none !important;
  user-drag: none !important;
}

html,
body.skyline-mobile {
  touch-action: none !important;
  overscroll-behavior: none !important;
}
